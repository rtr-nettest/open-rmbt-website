{
  "name": "open-rmbt-angular",
  "version": "0.0.0",
  "scripts": {
    "compile-deps-info": "npx ts-node scripts/compile-deps-info.ts",
    "generate-sitemap": "npx ts-node scripts/prepare-routes-for-sitemap.ts && npx ts-node scripts/generate-sitemap.ts",
    "ng": "ng",
    "start": "concurrently \"node proxy\" \"ng serve\"",
    "start:prod": "ng build && npx lite-server --baseDir=dist/open-rmbt-angular/browser",
    "start:stage": "ng serve --configuration=stage",
    "start:preprod": "ng serve --configuration=preprod",
    "build": "ng build",
    "build:preprod": "ng build --configuration=preprod",
    "build:stage": "ng build --configuration=stage",
    "build:dev3": "ng build --configuration=dev3",
    "build:dev": "ng build --configuration=dev",
    "build:rmbtws": "cd rmbtws && npm install && npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "set-prerender-routes": "npx ts-node scripts/set-prerender-routes.ts",
    "prepare": "husky",
    "preinstall": "git submodule init && git submodule update",
    "postinstall": "npm run build:rmbtws && node scripts/set-package-info.js",
    "prestart": "node scripts/set-package-info.js",
    "prebuild": "node scripts/set-package-info.js"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "undici": "7.30.0",
    "piscina": "5.3.2",
    "serialize-javascript": "^7.1.4",
    "vite": "^8.3.5",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.13.11",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "nanoid": "^3.3.18",
    "http-cache-semantics": "^4.3.0",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "follow-redirects": "^1.16.1"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@turf/bbox": "^7.1.0",
    "@turf/circle": "^7.2.0",
    "@turf/helpers": "^7.1.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.6",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "dayjs": "^1.11.13",
    "express": "^4.18.2",
    "file-saver": "^2.0.5",
    "formatcoords": "^1.1.3",
    "js-cookie": "^3.0.5",
    "maplibre-gl": "^6.8.0",
    "material-icons": "^1.13.12",
    "material-symbols": "^0.27.0",
    "ngx-matomo-client": "^10.0.0",
    "ol": "^10.4.0",
    "rmbtws": "./rmbtws",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@types/express": "^4.17.17",
    "@types/file-saver": "^2.0.7",
    "@types/formatcoords": "^1.1.2",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.15.0",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
